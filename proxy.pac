function FindProxyForURL(url, host) {
    // Если прокси-сервер (ESP32 или MacBook) недоступен — трафик идёт напрямую
    // Это предотвращает поломку сайта при падении прокси

    // 1. Перехватываем mitm.it — для скачивания сертификата (только если нужно)
    if (host == "mitm.it") {
        return "PROXY 192.168.1.X:8080; DIRECT";
    }

    // 2. Перехватываем nz.ua и все поддомены
    if (dnsDomainIs(host, "nz.ua") || shExpMatch(host, "*.nz.ua")) {
        // Сначала пытаемся через прокси, если он не отвечает — идём напрямую
        return "PROXY 192.168.1.X:8080; DIRECT";
    }

    // 3. ВСЁ ОСТАЛЬНОЕ — напрямую (без прокси)
    return "DIRECT";
}
